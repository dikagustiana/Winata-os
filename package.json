{
  "name": "winata-egg-position",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @winata/web dev",
    "build": "pnpm --filter @winata/web build",
    "start": "pnpm --filter @winata/web start",
    "typecheck": "tsc --noEmit -p packages/engine && tsc --noEmit -p packages/db && tsc --noEmit -p packages/parsers && tsc --noEmit -p apps/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "eslint . && tsx scripts/lint-ui.ts",
    "db:reset": "tsx scripts/reset-local-db.ts",
    "golden:week": "tsx scripts/compute-golden.ts",
    "golden:outlook": "tsx scripts/compute-golden-outlook.ts",
    "golden:cash": "tsx scripts/make-fixtures.ts",
    "fixtures:all": "tsx scripts/make-fixtures.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^9.37.0",
    "eslint-config-next": "^15.5.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4",
    "xlsx": "0.18.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@electric-sql/pglite",
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
