# Nama variabel saja. Tidak ada nilai/kunci di repo.
# Supabase (cloud)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hanya server: Auth admin (buat akun/kata sandi di /admin) dan Storage. Diisi pemilik.
SUPABASE_SERVICE_ROLE_KEY=
# Worker cloud (rebuild/kontrol/proyeksi): pooler Supabase transaction mode, port 6543.
SUPABASE_DB_URL=
CRON_SECRET=
# Lokal / e2e: "1" memakai auth palsu + PGlite di server. Tidak pernah aktif di Vercel.
MOCK_AUTH=
# Hanya e2e/CI: izinkan mode mock pada build produksi lokal (next start).
MOCK_AUTH_ALLOW_PRODUCTION_BUILD=
LOCAL_DB_DIR=.local-db
